<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#DCE2EC">

    <!-- Classic 2007 Roblox Red & Blue Top Portal Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#D82722">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="18dp"
            android:paddingVertical="14dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ROBLOX 2007 • OPENRBX"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.03"
                    android:fontFamily="sans-serif-black" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/subtitle"
                    android:textColor="#FFE2E0"
                    android:textSize="12sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btnAvatarEditor"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="@string/customize_avatar"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_retro_2007_button"
                android:paddingHorizontal="14dp" />
        </LinearLayout>

        <!-- Classic 2007 sub-nav bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:background="#29569B"
            android:gravity="center_vertical"
            android:paddingHorizontal="18dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvActiveAvatar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Bloxxer07 • Ready"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="My Places  |  Character  |  2007 SDK"
                android:textColor="#CFE0FF"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Featured 2007 Games Box -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_retro_2007_panel"
                android:padding="14dp"
                android:layout_marginBottom="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Featured 2007 Places"
                    android:textColor="#1F2B3D"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="10dp" />

                <!-- Crossroads -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="#FFFFFF"
                    android:padding="10dp"
                    android:layout_marginBottom="8dp">

                    <View
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:background="#287F47"
                        android:layout_marginEnd="12dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Crossroads (2007)"
                            android:textColor="#172334"
                            android:textStyle="bold"
                            android:textSize="14sp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Blackrock fort, skybridge, crates &amp; classic tools"
                            android:textColor="#596679"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/btnPlayCrossroads"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:text="Play"
                        android:textAllCaps="false"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:background="@drawable/bg_retro_2007_button"
                        android:paddingHorizontal="16dp" />
                </LinearLayout>

                <!-- Happy Home -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="#FFFFFF"
                    android:padding="10dp"
                    android:layout_marginBottom="8dp">

                    <View
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:background="#C4281C"
                        android:layout_marginEnd="12dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Happy Home in Robloxia"
                            android:textColor="#172334"
                            android:textStyle="bold"
                            android:textSize="14sp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Red-roofed house, lawn, fence &amp; tree"
                            android:textColor="#596679"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/btnPlayHappyHome"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:text="Play"
                        android:textAllCaps="false"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:background="@drawable/bg_retro_2007_button"
                        android:paddingHorizontal="16dp" />
                </LinearLayout>

                <!-- Classic Baseplate -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="#FFFFFF"
                    android:padding="10dp">

                    <View
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:background="#0D69AC"
                        android:layout_marginEnd="12dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Classic Studs Baseplate"
                            android:textColor="#172334"
                            android:textStyle="bold"
                            android:textSize="14sp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Sandbox tower, physics blocks &amp; 2007 sky"
                            android:textColor="#596679"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/btnPlayStarter"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:text="Play"
                        android:textAllCaps="false"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:background="@drawable/bg_retro_2007_button"
                        android:paddingHorizontal="16dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Import Local .rbxl -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_retro_2007_panel"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="10dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/recent_places"
                        android:textColor="#1F2B3D"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnOpenRbxl"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:text="@string/open_rbxl"
                        android:textAllCaps="false"
                        android:textStyle="bold"
                        android:textColor="#1F2B3D"
                        android:background="@drawable/bg_retro_2007_slot"
                        android:paddingHorizontal="12dp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvNoRecent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/no_recent_places"
                    android:textColor="#596679"
                    android:textSize="13sp"
                    android:paddingVertical="8dp" />

                <LinearLayout
                    android:id="@+id/recentPlacesContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
